# ==============================================================================
# Sentinel Platform - Production Environment Variables Example
# Duplicate this file as '.env' and modify settings for production/local deployment.
# ==============================================================================

# -----------------
# 1. DATABASE CONFIGURATIONS
# -----------------
# Format for Local SQLite Development:
# DATABASE_URL=sqlite+aiosqlite:///./dev.db
# Format for PostgreSQL Production:
DATABASE_URL=postgresql+asyncpg://sentinel_user:your_secure_password_here@localhost:5432/sentinel_db

# -----------------
# 2. MESSAGE BROKER & SEARCH INDEX CONFIGURATIONS (Optional, Fallback Enabled)
# -----------------
# Connection string for RabbitMQ Broker:
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# Connection URL for Elasticsearch Cluster:
ELASTICSEARCH_URL=http://localhost:9200

# -----------------
# 3. SECURITY & CRYPTOGRAPHY
# -----------------
# Secret key used for signing JWT login tokens (DO NOT USE DEFAULT IN PRODUCTION)
JWT_SECRET=generate_a_random_32_character_hex_string_and_paste_here
# Encryption algorithm used for JWT signatures:
JWT_ALGORITHM=HS256
# Token longevity in minutes:
ACCESS_TOKEN_EXPIRE_MINUTES=60

# -----------------
# 4. INSTANT MESSAGING ALERT NOTIFICATIONS (Optional)
# -----------------
# Slack Incoming Webhook endpoint URL:
SLACK_WEBHOOK_URL=your_slack_webhook_url_here
# Microsoft Teams Incoming Webhook endpoint URL:
TEAMS_WEBHOOK_URL=your_teams_webhook_url_here

# -----------------
# 5. SMTP EMAIL ALERT NOTIFICATIONS (Optional)
# -----------------
# Hostname of the mail server:
SMTP_HOST=smtp.gmail.com
# Port of the mail server (usually 587 for TLS, 465 for SSL):
SMTP_PORT=587
# Authentication email address for sending alerts:
SMTP_USER=alerts@yourdomain.com
# Password or app-specific password for the email address:
SMTP_PASSWORD=your_email_app_password
# Recipient address where critical security alert summaries are sent:
ALERT_EMAIL_RECIPIENT=soc-alerts@yourdomain.com
# Throttle cooldown period (in seconds) to avoid email spamming:
ALERT_THROTTLE_WINDOW=300
